{
  "name": "manual-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown と SVG からマニュアル（単一 HTML）を組み立てるブラウザアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:cli": "vite build --ssr scripts/build-cli.ts --outDir .cli",
    "cli": "node .cli/build-cli.js",
    "e2e": "node scripts/e2e-smoke.mjs",
    "package": "node scripts/package-deploy.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/node": "24.10.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
